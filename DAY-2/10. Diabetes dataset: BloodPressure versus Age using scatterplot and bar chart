diabetes <- read.csv("diabetes.csv")

plot(diabetes$Age, diabetes$BloodPressure,
     main = "Blood Pressure vs Age",
     xlab = "Age",
     ylab = "Blood Pressure",
     pch = 19,
     col = "blue")

age_groups <- cut(diabetes$Age,
                  breaks = c(0, 20, 30, 40, 50, 100),
                  labels = c("Below 20", "21-30", "31-40", "41-50", "Above 50"),
                  include.lowest = TRUE)

avg_bp <- aggregate(BloodPressure ~ age_groups,
                    data = diabetes,
                    FUN = mean,
                    na.rm = TRUE)

barplot(avg_bp$BloodPressure,
        names.arg = avg_bp$age_groups,
        main = "Average Blood Pressure by Age Group",
        xlab = "Age Group",
        ylab = "Average Blood Pressure",
        col = "skyblue")
